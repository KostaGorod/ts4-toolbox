{
  "name": "ts4-toolbox",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Fixes the Sims 4 llama-plumbob flicker glitch on old custom loading-screen .package mods. Browser-based bulk migrator; uses @s4tk/models for DBPF I/O.",
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "tsc --noEmit && bunx --bun vite build",
    "preview": "bunx --bun vite preview",
    "smoke": "bun scripts/smoke.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "^5.2.10",
    "@fontsource-variable/hanken-grotesk": "^5.2.8",
    "@s4tk/compression": "^0.2.0",
    "@s4tk/models": "^0.6.14",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.9",
    "vite-plugin-node-polyfills": "^0.26.0"
  }
}
